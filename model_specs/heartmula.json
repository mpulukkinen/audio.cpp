{
  "family": "heartmula",
  "display_name": "HeartMuLa",
  "category": "audio_generation",
  "status": "supported",
  "tasks": [
    "music"
  ],
  "modes": [
    "offline"
  ],
  "languages": [
    "en"
  ],
  "capabilities": {
    "music": [
      "lyrics"
    ]
  },
  "options": {
    "request": [
      {
        "name": "lyrics",
        "type": "string",
        "description": "Lyrics text.",
        "required": false
      },
      {
        "name": "tags",
        "type": "string_list",
        "description": "Comma-separated music tags.",
        "required": false
      },
      {
        "name": "duration_seconds",
        "type": "float",
        "description": "Maximum generated audio duration.",
        "required": false,
        "min": 0.0
      },
      {
        "name": "temperature",
        "type": "float",
        "description": "Audio token sampling temperature.",
        "required": false,
        "min": 0.0
      },
      {
        "name": "top_k",
        "type": "int",
        "description": "Audio token top-k sampling limit.",
        "required": false,
        "min": 0
      },
      {
        "name": "guidance_scale",
        "type": "float",
        "description": "MuLa classifier-free guidance scale.",
        "required": false,
        "min": 0.0
      },
      {
        "name": "codec_duration",
        "type": "float",
        "description": "Codec detokenization chunk duration.",
        "required": false,
        "min": 0.0
      },
      {
        "name": "num_inference_steps",
        "type": "int",
        "description": "Codec flow solver steps.",
        "required": false,
        "min": 1
      },
      {
        "name": "codec_guidance_scale",
        "type": "float",
        "description": "Codec classifier-free guidance scale.",
        "required": false,
        "min": 0.0
      },
      {
        "name": "infinite_mode",
        "type": "bool",
        "description": "Generate long outputs by splitting lyrics into bounded HeartMuLa requests.",
        "required": false,
        "default": false
      },
      {
        "name": "text_chunk_size",
        "type": "int",
        "description": "Text chunk size for infinite mode.",
        "required": false,
        "min": 0
      },
      {
        "name": "infinite_chunk_audio_length_ms",
        "type": "int",
        "description": "Per-chunk audio cap for infinite mode.",
        "required": false,
        "min": 0
      },
      {
        "name": "seed",
        "type": "int",
        "description": "Torch RNG seed.",
        "required": false,
        "min": 0
      }
    ],
    "session": [
      {
        "name": "weight_type",
        "type": "enum",
        "description": "MuLa and codec weight storage type.",
        "preset": "weight_type_full",
        "required": false
      },
      {
        "name": "mula_weight_type",
        "type": "enum",
        "description": "MuLa weight storage type.",
        "preset": "weight_type_full",
        "required": false
      },
      {
        "name": "codec_weight_type",
        "type": "enum",
        "description": "Codec weight storage type.",
        "preset": "weight_type_full",
        "required": false
      },
      {
        "name": "mula_weight_context_mb",
        "type": "int",
        "description": "MuLa weight context size.",
        "required": false,
        "min": 0
      },
      {
        "name": "codec_weight_context_mb",
        "type": "int",
        "description": "Codec weight context size.",
        "required": false,
        "min": 0
      },
      {
        "name": "mula_constant_context_mb",
        "type": "int",
        "description": "MuLa reusable constant context size.",
        "required": false,
        "min": 0
      },
      {
        "name": "mula_backbone_prefill_graph_arena_mb",
        "type": "int",
        "description": "MuLa backbone prefill graph arena size.",
        "required": false,
        "min": 0
      },
      {
        "name": "mula_backbone_step_graph_arena_mb",
        "type": "int",
        "description": "MuLa backbone cached-step graph arena size.",
        "required": false,
        "min": 0
      },
      {
        "name": "mula_decoder_prefill_graph_arena_mb",
        "type": "int",
        "description": "MuLa decoder prefill graph arena size.",
        "required": false,
        "min": 0
      },
      {
        "name": "mula_decoder_step_graph_arena_mb",
        "type": "int",
        "description": "MuLa decoder cached-step graph arena size.",
        "required": false,
        "min": 0
      },
      {
        "name": "mula_frame_embedding_graph_arena_mb",
        "type": "int",
        "description": "MuLa frame-embedding graph arena size.",
        "required": false,
        "min": 0
      },
      {
        "name": "codec_flow_estimator_graph_arena_mb",
        "type": "int",
        "description": "Codec flow-estimator graph arena size.",
        "required": false,
        "min": 0
      },
      {
        "name": "codec_conditioning_graph_arena_mb",
        "type": "int",
        "description": "Codec conditioning graph arena size.",
        "required": false,
        "min": 0
      },
      {
        "name": "codec_scalar_decoder_graph_arena_mb",
        "type": "int",
        "description": "Codec scalar-decoder graph arena size.",
        "required": false,
        "min": 0
      },
      {
        "name": "mem_saver",
        "type": "bool",
        "description": "Release staged runtime graphs after each request; default false.",
        "required": false,
        "default": false
      }
    ],
    "load": []
  },
  "runtime": {
    "tags": [
      "gguf"
    ]
  },
  "sources": [
    {
      "format": "gguf",
      "roots": {
        "model": ".",
        "weights": "$gguf"
      },
      "files": {
        "tokenizer_json": "model:tokenizer.json",
        "generation_config": "model:gen_config.json",
        "mula_config": "model:HeartMuLa-oss-3B/config.json",
        "codec_config": "model:HeartCodec-oss/config.json"
      },
      "tensors": {
        "mula_weights": {
          "source": "weights:",
          "prefix": "mula_weights"
        },
        "codec_weights": {
          "source": "weights:",
          "prefix": "codec_weights"
        }
      }
    },
    {
      "format": "safetensors",
      "roots": {
        "model": "."
      },
      "files": {
        "tokenizer_json": "model:tokenizer.json",
        "generation_config": "model:gen_config.json",
        "mula_config": "model:HeartMuLa-oss-3B/config.json",
        "codec_config": "model:HeartCodec-oss/config.json"
      },
      "tensors": {
        "mula_weights": "model:HeartMuLa-oss-3B/model.safetensors.index.json",
        "codec_weights": "model:HeartCodec-oss/model.safetensors.index.json"
      }
    }
  ],
  "package_defaults": {
    "download": {
      "kind": "huggingface_snapshot",
      "repo": "audio-cpp/audio.cpp-gguf",
      "revision": "main",
      "gated": false
    }
  },
  "packages": [
    {
      "id": "heartmula_q8_0",
      "display_name": "HeartMuLa Q8_0 GGUF",
      "default": true,
      "format": "gguf",
      "precision": "q8_0",
      "target_directory": "HeartMuLa-GGUF",
      "files": [
        "HeartMuLa-GGUF/heartmula-q8_0.gguf"
      ],
      "strip_prefix": "HeartMuLa-GGUF"
    },
    {
      "id": "heartmula_f16",
      "display_name": "HeartMuLa F16 GGUF",
      "format": "gguf",
      "precision": "f16",
      "target_directory": "HeartMuLa-GGUF",
      "files": [
        "HeartMuLa-GGUF/heartmula-f16.gguf"
      ],
      "strip_prefix": "HeartMuLa-GGUF"
    }
  ]
}
