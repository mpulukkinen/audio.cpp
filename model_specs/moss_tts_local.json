{
  "family": "moss_tts_local",
  "display_name": "MOSS-TTS-Local",
  "category": "tts",
  "status": "supported",
  "tasks": [
    "tts",
    "clone"
  ],
  "modes": [
    "offline"
  ],
  "languages": [
    "en",
    "zh"
  ],
  "capabilities": {
    "clone": [
      "speaker_reference"
    ]
  },
  "options": {
    "request": [
      {
        "name": "max_tokens",
        "type": "int",
        "description": "Maximum generated audio frames.",
        "required": false,
        "min": 0
      },
      {
        "name": "do_sample",
        "type": "bool",
        "description": "Enable stochastic audio-token sampling.",
        "required": false,
        "default": false
      },
      {
        "name": "temperature",
        "type": "float",
        "description": "Audio-token sampling temperature.",
        "required": false,
        "min": 0.0
      },
      {
        "name": "top_p",
        "type": "float",
        "description": "Audio-token nucleus sampling limit.",
        "required": false,
        "min": 0.0,
        "max": 1.0
      },
      {
        "name": "top_k",
        "type": "int",
        "description": "Audio-token top-k sampling limit.",
        "required": false,
        "min": 0
      },
      {
        "name": "repetition_penalty",
        "type": "float",
        "description": "Audio-token repetition penalty.",
        "required": false,
        "min": 0.0
      },
      {
        "name": "text_temperature",
        "type": "float",
        "description": "Text-gate sampling temperature.",
        "required": false
      },
      {
        "name": "text_top_p",
        "type": "float",
        "description": "Text-gate nucleus sampling limit.",
        "required": false
      },
      {
        "name": "text_top_k",
        "type": "int",
        "description": "Text-gate top-k sampling limit.",
        "required": false
      },
      {
        "name": "text_chunk_mode",
        "type": "enum",
        "description": "Long-form text chunking mode; default splitter.",
        "preset": "text_chunk_mode_full",
        "required": false,
        "default": "default"
      }
    ],
    "session": [
      {
        "name": "weight_type",
        "type": "enum",
        "description": "Backbone weight storage type.",
        "values": [
          "auto",
          "native",
          "f32",
          "f16",
          "bf16",
          "q8_0"
        ],
        "required": false
      },
      {
        "name": "reference_cache_slots",
        "type": "int",
        "description": "Prepared reference-voice cache slots; default 1, set 0 to disable.",
        "required": false,
        "min": 0
      }
    ],
    "load": []
  },
  "runtime": {
    "tags": [
      "gguf"
    ]
  },
  "sources": [
    {
      "format": "gguf",
      "roots": {
        "model": ".",
        "weights": "$gguf"
      },
      "files": {
        "config": "model:config.json",
        "tokenizer_json": "model:tokenizer.json",
        "tokenizer_config": "model:tokenizer_config.json",
        "tokenizer_vocab": "model:vocab.json",
        "tokenizer_merges": "model:merges.txt",
        "audio_tokenizer_config": "model:audio_tokenizer/config.json"
      },
      "tensors": {
        "model_weights": {
          "source": "weights:",
          "prefix": "model_weights"
        },
        "audio_tokenizer_weights": {
          "source": "weights:",
          "prefix": "audio_tokenizer_weights"
        }
      }
    },
    {
      "format": "safetensors",
      "roots": {
        "model": ".",
        "audio_tokenizer": "audio_tokenizer"
      },
      "files": {
        "config": "model:config.json",
        "tokenizer_json": "model:tokenizer.json",
        "tokenizer_config": "model:tokenizer_config.json",
        "tokenizer_vocab": "model:vocab.json",
        "tokenizer_merges": "model:merges.txt",
        "audio_tokenizer_config": "audio_tokenizer:config.json"
      },
      "tensors": {
        "model_weights": "model:model.safetensors",
        "audio_tokenizer_weights": "audio_tokenizer:model.safetensors.index.json"
      }
    }
  ],
  "package_defaults": {
    "download": {
      "kind": "huggingface_snapshot",
      "repo": "audio-cpp/audio.cpp-gguf",
      "revision": "main",
      "gated": false
    }
  },
  "packages": [
    {
      "id": "moss_tts_local_v1_5_q8_0",
      "display_name": "MOSS-TTS-Local v1.5 Q8_0 GGUF",
      "default": true,
      "format": "gguf",
      "precision": "q8_0",
      "target_directory": "MOSS-TTS-Local-v1.5-GGUF",
      "files": [
        "MOSS-TTS-Local-v1.5-GGUF/moss-tts-local-v1.5-q8_0.gguf"
      ],
      "strip_prefix": "MOSS-TTS-Local-v1.5-GGUF"
    },
    {
      "id": "moss_tts_local_v1_5_bf16",
      "display_name": "MOSS-TTS-Local v1.5 BF16 GGUF",
      "format": "gguf",
      "precision": "bf16",
      "target_directory": "MOSS-TTS-Local-v1.5-GGUF",
      "files": [
        "MOSS-TTS-Local-v1.5-GGUF/moss-tts-local-v1.5-bf16.gguf"
      ],
      "strip_prefix": "MOSS-TTS-Local-v1.5-GGUF"
    }
  ]
}
