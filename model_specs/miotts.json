{
  "family": "miotts",
  "display_name": "MioTTS",
  "category": "tts",
  "status": "supported",
  "tasks": [
    "tts",
    "clone"
  ],
  "modes": [
    "offline"
  ],
  "languages": [
    "en",
    "ja"
  ],
  "capabilities": {
    "clone": [
      "speaker_reference"
    ]
  },
  "options": {
    "request": [
      {
        "name": "best_of_n",
        "type": "int",
        "description": "Generate n candidates for this request and select by ASR scoring.",
        "required": false,
        "min": 1
      },
      {
        "name": "best_of_n_enabled",
        "type": "bool",
        "description": "Enable best-of-N candidate selection for this request.",
        "required": false,
        "default": false
      },
      {
        "name": "best_of_n_language",
        "type": "enum",
        "description": "Language used when scoring best-of-N candidates.",
        "preset": "best_of_n_language",
        "required": false,
        "default": "auto"
      }
    ],
    "session": [
      {
        "name": "codec_path",
        "type": "path",
        "description": "MioCodec model directory used by MioTTS acoustic decoding.",
        "required": false
      },
      {
        "name": "best_of_n_enabled",
        "type": "bool",
        "description": "Enable best-of-N candidate selection by default.",
        "required": false,
        "default": false
      },
      {
        "name": "best_of_n_default",
        "type": "int",
        "description": "Default best-of-N candidate count.",
        "required": false,
        "min": 1
      },
      {
        "name": "best_of_n_max",
        "type": "int",
        "description": "Maximum best-of-N candidate count.",
        "required": false,
        "min": 1
      },
      {
        "name": "best_of_n_language",
        "type": "enum",
        "description": "Default language used when scoring best-of-N candidates.",
        "preset": "best_of_n_language",
        "required": false,
        "default": "auto"
      },
      {
        "name": "best_of_n_asr_path",
        "type": "path",
        "description": "Qwen3-ASR model directory used by best-of-N scoring.",
        "required": false
      },
      {
        "name": "weight_type",
        "type": "enum",
        "description": "MioTTS language-model matmul weight storage type.",
        "preset": "weight_type_full",
        "required": false
      }
    ],
    "load": []
  },
  "runtime": {
    "tags": [
      "gguf"
    ]
  },
  "sources": [
    {
      "format": "gguf",
      "roots": {
        "model": ".",
        "weights": "$gguf"
      },
      "files": {
        "config": "model:config.json",
        "generation_config": "model:generation_config.json",
        "tokenizer_config": "model:tokenizer_config.json",
        "vocab": "model:vocab.json",
        "merges": "model:merges.txt"
      },
      "optional_files": {
        "tokenizer_json": "model:tokenizer.json"
      },
      "tensors": {
        "weights": "weights:"
      }
    },
    {
      "format": "safetensors",
      "roots": {
        "model": "."
      },
      "files": {
        "config": "model:config.json",
        "generation_config": "model:generation_config.json",
        "tokenizer_config": "model:tokenizer_config.json",
        "vocab": "model:vocab.json",
        "merges": "model:merges.txt"
      },
      "optional_files": {
        "tokenizer_json": "model:tokenizer.json"
      },
      "tensors": {
        "weights": "model:model.safetensors"
      }
    }
  ],
  "package_defaults": {
    "download": {
      "kind": "huggingface_snapshot",
      "repo": "audio-cpp/audio.cpp-gguf",
      "revision": "main",
      "gated": false
    }
  },
  "packages": [
    {
      "id": "miotts_1_7b_q8_0",
      "display_name": "MioTTS 1.7B Q8_0 GGUF",
      "default": true,
      "format": "gguf",
      "precision": "q8_0",
      "target_directory": "MioTTS-1.7B-GGUF",
      "files": [
        "MioTTS-1.7B-GGUF/miotts-1.7b-q8_0.gguf"
      ],
      "strip_prefix": "MioTTS-1.7B-GGUF"
    },
    {
      "id": "miotts_1_7b_bf16",
      "display_name": "MioTTS 1.7B BF16 GGUF",
      "format": "gguf",
      "precision": "bf16",
      "target_directory": "MioTTS-1.7B-GGUF",
      "files": [
        "MioTTS-1.7B-GGUF/miotts-1.7b-bf16.gguf"
      ],
      "strip_prefix": "MioTTS-1.7B-GGUF"
    },
    {
      "id": "miotts_1_7b_orig",
      "display_name": "MioTTS 1.7B Original-Dtype GGUF",
      "format": "gguf",
      "precision": "orig",
      "target_directory": "MioTTS-1.7B-GGUF",
      "files": [
        "MioTTS-1.7B-GGUF/miotts-1.7b-orig.gguf"
      ],
      "strip_prefix": "MioTTS-1.7B-GGUF"
    }
  ],
  "dependencies": [
    {
      "kind": "model",
      "family": "miocodec",
      "scope": "session",
      "option": "codec_path",
      "required": true
    },
    {
      "kind": "model",
      "family": "qwen3_asr",
      "scope": "session",
      "option": "best_of_n_asr_path",
      "required": false,
      "required_when": [
        {
          "scope": "session",
          "option_key": "miotts.best_of_n_enabled",
          "equals": true
        },
        {
          "scope": "request",
          "option_key": "best_of_n_enabled",
          "equals": true
        }
      ]
    }
  ]
}
